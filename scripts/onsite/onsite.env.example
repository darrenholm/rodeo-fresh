# Copy to onsite.env on the Mini PC and fill in. NEVER commit onsite.env.
# Cloud = Railway "Holmdale Rodeo" Postgres (DATABASE_PUBLIC_URL from the Postgres service).
CLOUD_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway
# Local = the Mini PC's own Postgres.
LOCAL_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/rodeo
# Where 15-minute dumps land (created if missing).
BACKUP_DIR=C:\rodeo\backups
# Optional second copy of each dump (OneDrive folder, UNC share, USB). Blank to skip.
BACKUP_MIRROR_DIR=
# Postgres bin folder (pg_dump/pg_restore/psql).
PG_BIN=C:\Program Files\PostgreSQL\16\bin
